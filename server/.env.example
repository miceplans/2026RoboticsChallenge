# 개발용 환경변수 — server/.env 로 복사해 쓴다 (server/.env 는 git 에 올리지 않는다)
# 여기의 값은 예시가 아니라 빈 값 그대로 둔다. 실제 값은 server/.env(개발) 또는 배포 환경변수에만 둔다.

# 세션 서명 키 (Next 와 이 서버가 같은 값을 쓴다). 운영 필수, 32자 이상의 임의 값.
AUTH_SECRET=

# 서버 간 호출 공유 비밀 — Next 가 /auth/* 를 호출할 때 본다. 운영 필수, 32자 이상의 임의 값.
INTERNAL_API_SECRET=

# 계정 비밀번호 초기화용 공통 비밀번호 (관리자가 재발급하면 이 값으로 돌아감). 운영 필수.
# 개발에서 비워 두면 부팅 때마다 임의 값이 생성돼 서버 로그에 한 번 출력된다.
DEFAULT_PASSWORD=

# 최초 기동 시 관리자 계정이 없으면 ADMIN_INITIAL_ID(기본 admin)를 이 비밀번호로 만든다 (임시 — 로그인 후 변경 강제).
# 비밀번호가 없으면 계정을 만들지 않는다.
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_ID=
# 있으면 심판 REF01~REF08 도 함께 만든다 (임시 — 로그인 후 변경 강제).
JUDGE_INITIAL_PASSWORD=

# DB 파일 경로 (기본 contest.db). 운영에서는 /data/contest.db 처럼 볼륨 경로를 권장.
DB_PATH=

# 허용 브라우저 출처 (쉼표 구분). 운영 필수. 미설정 시 개발용 localhost 목록만 허용된다.
CORS_ORIGINS=

# 앞에 신뢰할 프록시(Caddy 등)가 있을 때만 1 — 클라이언트 IP 를 x-forwarded-for 에서 읽는다.
TRUST_PROXY=

# 쿠키 secure 플래그를 무조건 켠다 (기본: x-forwarded-proto=https 일 때만 secure).
COOKIE_SECURE=

# 서버 포트 (기본 4000)
PORT=
